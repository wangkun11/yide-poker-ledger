/* 顶栏保持单行；显式覆盖微信 mini 按钮的默认 inline-block 和内边距。 */
.account,.compact .account{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px;height:30px;font-size:11px;margin-bottom:12px}
.account-brand{white-space:nowrap}
.account .sync,.compact .account .sync{min-width:0;max-width:none;text-align:center;font-size:10px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:24px}
.account .toolbar,.compact .account .toolbar{display:flex;align-items:center;justify-content:flex-end;gap:12px;height:30px;padding:0;font-size:11px;white-space:nowrap}
.account .toolbar text{line-height:30px}
.compact .account{margin-bottom:0}
button[size="mini"]{display:flex;align-items:center;justify-content:center;width:auto;min-width:0;height:32px;min-height:0;margin:0;padding:0 12px;line-height:1.2;box-sizing:border-box;white-space:nowrap;flex-shrink:0}
.heading>view{min-width:0;flex:1}
.heading>button[size="mini"]{height:32px;padding:0 12px;align-self:center}
@media(max-width:350px){.account,.compact .account{gap:5px;font-size:10px}.account .toolbar,.compact .account .toolbar{gap:8px;font-size:10px}.account .sync,.compact .account .sync{font-size:9px}}

/* 按钮不依赖 size=mini 的系统样式；文字作为独立 flex 子项居中。 */
button.ui-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:44px;min-height:0;min-width:0;margin:0;padding:0 14px;line-height:normal;font-size:14px;font-weight:500;border-radius:8px;flex-shrink:0}
button.ui-button .button-label{display:block;flex:0 1 auto;min-width:0;line-height:1.3;text-align:center;word-break:break-word}
button.ui-button-small{display:flex;width:auto;height:36px;padding:0 12px;font-size:12px;white-space:nowrap}
button.ui-button-small .button-label{white-space:nowrap}
button.ui-button.join-button{width:100%;height:32px;padding:0 10px;border-radius:24px}
.table-actions button.ui-button{flex:1 1 0%;width:0;height:32px;padding:0 8px;font-size:12px}
.mini-stepper button.ui-button{width:25px;min-width:25px;height:25px;padding:0;border-radius:50%;font-size:20px}
.mini-stepper button.ui-button .button-label{line-height:1}
.sheet button.ui-button{margin-top:10px}
/* 固定输入与相邻按钮高度，避免 rpx 随屏宽放大而与 px 按钮错位。 */
.add{gap:12px}.add input{flex:1 1 0%;width:0;min-width:0;height:40px;padding:0 10px;font-size:15px}
.add button.ui-button{height:40px;min-width:60px;font-size:14px}
.fees input{height:40px;padding:0 10px;font-size:15px;width:100%}
.friend>text{flex:1;min-width:0;overflow-wrap:break-word;word-break:break-all}
.friend>view{flex-shrink:0;white-space:nowrap}
.history label>view,.detail-row>view{min-width:0;overflow-wrap:break-word;word-break:break-all}
.history checkbox,.detail-row>text{flex-shrink:0}
.result .row{flex-wrap:wrap;align-items:baseline}.result .row>text:first-child{min-width:0;overflow-wrap:break-word;word-break:break-all}
.result .number{margin-left:auto;max-width:100%;overflow-wrap:anywhere;font-size:22px}
.result-detail{overflow-wrap:break-word;word-break:break-all}
.app:not(.compact){padding-bottom:calc(100px + env(safe-area-inset-bottom))}
.nav>view{min-width:0}.nav text{white-space:nowrap}
.overlay{padding:16px;padding-bottom:calc(16px + env(safe-area-inset-bottom))}
.sheet{display:flex;flex-direction:column;max-height:85vh;padding:20px;min-height:0}
.pick-list{height:40vh;max-height:40vh;min-height:0;flex-shrink:1;margin:16px 0 6px}
.pick-list label{word-break:break-all}.pick-list checkbox{flex-shrink:0}
.account,.compact .account{display:flex}.account-brand{flex-shrink:0}.account .sync,.compact .account .sync{flex:1}.account .toolbar{flex-shrink:0}
@media(max-width:350px){.app{padding-left:12px;padding-right:12px}.card{padding:20rpx}.heading .title{font-size:36rpx}.heading{gap:8px}.friend>view{gap:14px}.fees{gap:12px}.add{gap:8px}.add button.ui-button{min-width:52px;padding:0 10px}.table-totals,.table-pager{flex-wrap:wrap;height:auto;min-height:25px;row-gap:4px}}
@media(max-height:600px){.sheet{max-height:90vh;padding:16px}.pick-list{height:32vh;max-height:32vh}.login{padding-top:35px}}

/* 左右使用等宽区域，状态中心固定在整行的 50%，不受操作区宽度影响。 */
.account,.compact .account{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr)}
.account .account-brand{justify-self:start;min-width:0}
.account .sync,.compact .account .sync{justify-self:center;max-width:120px;flex:none}
.account .toolbar,.compact .account .toolbar{justify-self:end;min-width:0}
@media(max-width:350px){.account .sync,.compact .account .sync{max-width:100px}}

/* 好友页采用连续列表，常见竖屏为 15 行预留空间。 */
.friends-compact{padding-top:10px}
.friends-compact .heading{margin:0 0 10px}
.friends-compact .heading .title{font-size:22px;line-height:28px}
.friends-compact .heading .sub{font-size:11px;line-height:18px}
.friends-compact .add{padding:8px;margin-bottom:10px;border-radius:10px}
.friends-compact .add input,.friends-compact .add button.ui-button{height:34px;font-size:13px}
.friends-list{background:#fff;border:1px solid #e4ece5;border-radius:10px;overflow:hidden}
.friends-list:empty{display:none}
.friends-compact .card.friend{height:clamp(28px,calc((100vh - 235px - env(safe-area-inset-bottom)) / 15),38px);min-height:28px;padding:0 12px;margin:0;border:0;border-bottom:1px solid #edf1ed;border-radius:0;gap:12px;font-size:13px;line-height:1.3}
.friends-compact .card.friend:last-child{border-bottom:0}
.friends-compact .friend>text{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.friends-compact .friend>view{align-items:center;gap:4px;height:100%;font-size:11px}
.friends-compact .friend>view>text{display:flex;align-items:center;justify-content:center;height:100%;min-width:36px;padding:0 6px}
.friends-compact .note{font-size:11px;line-height:1.6;margin:10px 0}
.friends-compact .nav{padding:4px 5px calc(4px + env(safe-area-inset-bottom))}
.friends-compact .nav>view{font-size:19px;padding:2px}
.friends-compact .nav text{font-size:10px;margin:0}

/* 好友上桌：三列勾选，长昵称换行，整块 label 可点击。 */
.friend-picker-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:2px}
.pick-list .friend-picker-option{display:flex;align-items:center;min-width:0;min-height:48px;margin:0;padding:8px 5px;gap:4px;border:1px solid #e4ece5;border-radius:8px;background:#f7faf7;font-size:12px;line-height:1.4}
.friend-picker-option checkbox{flex:none;transform:scale(.8);transform-origin:center;width:24px}
.friend-picker-name{flex:1;min-width:0;word-break:break-all}
@media(max-width:350px){.friend-picker-grid{gap:5px}.pick-list .friend-picker-option{padding:7px 3px;gap:2px;font-size:11px}}

/* 历史与结算使用连续行，按可用屏高为 15 行分配空间。 */
.records-compact{padding:10px 12px calc(70px + env(safe-area-inset-bottom))}
.records-compact .heading{margin:0 0 10px;gap:8px}
.records-compact .heading .title{font-size:22px;line-height:28px}
.records-compact .heading .sub{font-size:11px;line-height:18px}
.records-compact .nav{padding:4px 5px calc(4px + env(safe-area-inset-bottom))}
.records-compact .nav>view{font-size:19px;padding:2px}
.records-compact .nav text{font-size:10px;margin:0}
.history-list{display:block;background:white;border:1px solid #e4ece5;border-radius:10px;overflow:hidden;margin-bottom:10px}
.history-list:empty{display:none}
.records-compact .history{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:32px;height:clamp(32px,calc((100vh - 180px - env(safe-area-inset-bottom)) / 15),40px);margin:0;padding:2px 8px;border:0;border-bottom:1px solid #edf1ed;border-radius:0}
.records-compact .history:last-child{border-bottom:0}
.records-compact .history label{flex:1;min-width:0;gap:4px;height:100%}
.records-compact .history label>view{flex:1;min-width:0}
.records-compact .history checkbox{transform:scale(.75);width:25px;flex-shrink:0}
.history-title{font-size:12px;line-height:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.records-compact .history .sub{font-size:9px;line-height:12px}
.records-compact .history-actions{flex-shrink:0;gap:12px;margin:0;font-size:11px;align-items:center;height:100%}
.records-compact .history-actions text{display:flex;align-items:center;height:100%;padding:0 3px}
.records-compact>button.ui-button{height:34px;font-size:13px}
.records-compact .settlement-fees{padding:8px 10px;margin-bottom:8px;border-radius:10px}
.settlement-fees .section-head{margin-bottom:6px;font-size:12px;line-height:16px}
.settlement-fees .section-head .sub{font-size:10px}
.settlement-fees .fees{margin:0;gap:12px}
.settlement-fees .fees>view{display:flex;align-items:center;gap:6px}
.settlement-fees .label{margin:0;white-space:nowrap;font-size:11px}
.settlement-fees .fees input{flex:1;min-width:0;width:0;height:28px;font-size:13px;padding:0 7px}
.settlement-fees .warning{padding:4px 0;background:transparent;font-size:10px;line-height:14px}
.settlement-table{border:1px solid #e4ece5;border-radius:10px;background:white;overflow:hidden}
.settlement-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.15fr) minmax(0,.8fr) minmax(0,.8fr) minmax(0,1.2fr);gap:4px;align-items:center;padding:0 8px;font-size:11px;font-variant-numeric:tabular-nums}
.settlement-grid>text{text-align:right;word-break:break-all;line-height:1.3}
.settlement-head{height:26px;background:#edf5ee;color:#6f8577;font-size:10px}
.settlement-head>text:first-child{text-align:left}
.settlement-row{min-height:26px;min-height:clamp(26px,calc((100vh - 304px - env(safe-area-inset-bottom)) / 15),36px);border-top:1px solid #edf1ed;padding-top:2px;padding-bottom:2px}
.settlement-person{min-width:0;display:flex;flex-wrap:wrap;align-items:center;column-gap:4px;line-height:1.3;word-break:break-all}
.settlement-person .games{color:#8a9c8e;font-size:9px;white-space:nowrap}
.settlement-net{font-weight:600}
.settlement-foot{font-size:10px;color:#819486;line-height:15px;margin-top:6px}
@media(max-width:350px){.settlement-grid{font-size:10px;gap:3px;padding-left:6px;padding-right:6px}.settlement-head{font-size:9px}.records-compact .history-actions{gap:6px}}

/* 历史详情以日期为标题，最多 15 行同屏，更多记录在表内滚动。 */
.history-detail{--detail-row-height:clamp(24px,calc((85vh - 150px) / 15),36px);padding:16px;max-height:85vh}
.history-detail .title{font-size:22px;line-height:28px;flex-shrink:0}
.detail-meta{font-size:11px;line-height:18px;color:#819486;margin:4px 0 8px;flex-shrink:0}
.detail-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.55fr) minmax(0,1.1fr) minmax(0,1.15fr);gap:6px;align-items:center;font-size:12px;line-height:1.3}
.detail-grid>text{min-width:0;word-break:break-all;text-align:right}
.detail-grid>text:first-child{text-align:left}
.detail-grid>text:nth-child(2){text-align:center}
.detail-head{height:26px;flex-shrink:0;background:#edf5ee;color:#819486;font-size:11px;padding:0 6px;border-radius:6px 6px 0 0}
.history-detail .detail-scroll{min-height:0;flex-shrink:1;border-bottom:1px solid #e4ece5}
.detail-compact-row{min-height:var(--detail-row-height);padding:3px 6px;border-top:1px solid #edf1ed}
.history-detail button.ui-button{height:34px;flex-shrink:0;margin-top:10px}
@media(max-width:350px){.history-detail{padding:12px}.detail-grid{font-size:11px;gap:4px}.detail-meta{font-size:10px}}

.game-room{display:flex;align-items:center;gap:8px;height:34px;font-size:11px;color:#678470}
.game-room input{width:95px;height:28px;padding:0 6px;font-size:12px}
.game-room picker{flex:1;min-width:0;text-align:right}.game-room picker text{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.carried-room{font-size:11px;line-height:28px;word-break:break-all}
.settlement-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr) minmax(0,.7fr) minmax(0,.7fr) minmax(0,.9fr) minmax(0,1.15fr);font-size:10px;gap:3px;padding-left:6px;padding-right:6px}
.settlement-head{font-size:9px}
.detail-room{font-size:10px;color:#819486;line-height:16px;margin-bottom:6px;flex-shrink:0}
.history-detail{--detail-row-height:clamp(24px,calc((85vh - 176px) / 15),36px)}

.meal-payer{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;line-height:24px;color:#678470}.meal-payer picker{flex:1;min-width:0;text-align:right}.meal-payer picker text{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.history-edit{max-height:88vh;padding:16px;display:flex;flex-direction:column;box-sizing:border-box}.history-edit .title{font-size:20px;margin-bottom:8px}.edit-meta{display:flex;align-items:center;gap:8px;font-size:11px;min-height:34px;flex-shrink:0}.edit-meta picker{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.edit-meta input{width:80px;height:28px;padding:0 5px;font-size:12px}.edit-grid{display:grid;grid-template-columns:minmax(0,1fr) 44px minmax(0,1fr) minmax(0,1fr);gap:5px;align-items:center;font-size:11px}.edit-grid>text{text-align:right}.edit-grid>text:first-child{text-align:left}.edit-row{height:30px;border-bottom:1px solid #edf1ed}.edit-row input{width:100%;min-width:0;box-sizing:border-box;height:26px;padding:0 4px;font-size:11px}.edit-scroll{height:450px;max-height:calc(88vh - 205px);min-height:0}.history-edit .table-actions{flex-shrink:0}.history-edit .detail-meta{margin:6px 0}
